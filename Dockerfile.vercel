FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_sqlite

WORKDIR /app

FROM node:22-bookworm-slim AS assets

WORKDIR /app

COPY package.json package-lock.json ./
COPY vite.config.js ./
COPY resources ./resources

RUN npm ci && npm run build

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

COPY . .
COPY --from=assets /app/public/build /app/public/build

ENV DB_CONNECTION=sqlite \
    DB_DATABASE=/app/database/database.sqlite \
    APP_ENV=production \
    APP_KEY=base64:2fl+Ktvkfl+Fuz4Qp/Vj75XuU/d1L8XN0Z4IhNvR3mM=

RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && touch database/database.sqlite \
    && composer dump-autoload --no-dev --classmap-authoritative \
    && php artisan migrate --force --no-interaction

FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    CACHE_STORE=array \
    SESSION_DRIVER=cookie \
    QUEUE_CONNECTION=sync \
    DB_CONNECTION=sqlite \
    DB_DATABASE=/app/database/database.sqlite \
    MAIL_MAILER=smtp \
    MAIL_HOST=smtp.gmail.com \
    MAIL_PORT=587 \
    MAIL_USERNAME=canislupus9385@gmail.com \
    MAIL_FROM_ADDRESS=canislupus9385@gmail.com \
    MAIL_FROM_NAME="KONLANI Yentchabré Modeste"

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
